data <- data.frame(species = gsub(" ", "_", data$Species), duration = data$`Mean duration (ms)`, count = data$Frequency)
# #explore mismatched species
# unique_species <- unique(data$species)
# missing_species <- c(1:length(unique_species))[-which(unique_species %in% tree$tip.label)]
# missing_species <- unique_species[missing_species]
#overwrite mismatched species names (some are the same, some close, some close enough)
tree$tip.label[which(tree$tip.label == "Eulemur_macaco_macaco")] <- "Eulemur_macaco" #same
tree$tip.label[which(tree$tip.label == "Galago_senegalensis")] <- "Galagos_senegalensis" #same
tree$tip.label[which(tree$tip.label == "Gorilla_gorilla_gorilla")] <- "Gorilla_gorilla" #same
tree$tip.label[which(tree$tip.label == "Macaca_cyclopis")] <- "Macaca_cyclopsis" #same
tree$tip.label[which(tree$tip.label == "Macaca_fascicularis")] <- "Macaca_fasicularis" #same
tree$tip.label[which(tree$tip.label == "Pithecia_irrorata")] <- "Pithecia_chrysocephala" #close
tree$tip.label[which(tree$tip.label == "Presbytis_melalophos")] <- "Presbytis_johnii" #close
tree$tip.label[which(tree$tip.label == "Semnopithecus_entellus")] <- "Presbytis_entellus" #same
tree$tip.label[which(tree$tip.label == "Cebus_albifrons")] <- "Sapajus_flavius" #close(ish)
tree$tip.label[which(tree$tip.label == "Cebus_olivaceus")] <- "Sapajus_libidinosus" #close(ish)
#drop all other tips from tree
tree <- drop.tip(tree, setdiff(tree$tip.label, data$species))
#ensure matching tip labels
data$species <- factor(data$species, levels = tree$tip.label)
#get covariance matrix from tree
tree_covar <- vcv.phylo(tree, corr = TRUE)
data
x <- unique(data$species)[1]
temp <- data[which(data$species == x),]
temp
temp$duration <- temp$duration*temp$count
temp
data_summed <- do.call(rbind, lapply(unique(data$species), function(x){
temp <- data[which(data$species == x),]
temp$duration <- temp$duration*temp$count
temp$duration <- scale(log(temp$duration))
temp$count <- scale(log(temp$count))
return(temp)
}))
data_summed <- do.call(rbind, lapply(unique(data$species), function(x){
temp <- data[which(data$species == x),]
temp$duration <- temp$duration*temp$count
temp$duration <- scale(log(temp$duration))
temp$count <- scale(log(temp$count))
return(temp)
}))
#run combined model
#because of group mean centering above, species is only a random slope and not an intercept
#capture output is used to prevent sampling from overwhelming the markdown file
set.seed(12345)
output <- capture.output(
combined_model_summed <- brm(
duration ~ count + (0 + count|gr(species, cov = tree_covar)),
data = data_summed,
family = gaussian(),
data2 = list(tree_covar = tree_covar),
prior = c(
prior(normal(0, 0.5), class = "b"),
prior(normal(0, 0.5), class = "Intercept"),
prior(exponential(2), class = "sd"),
prior(exponential(2), class = "sigma")
),
chains = 10,
cores = 10,
iter = 10000,
backend = "cmdstanr"
)
)
combined_model_summed
#to extract the coefficients for each species
species_coefs <- coef(combined_model_summed)$species[, , 1]
species_coefs
#iterate through species, convert mean duration to cumulative duration, and apply log transformation and group mean centering
data_summed <- do.call(rbind, lapply(unique(data$species), function(x){
temp <- data[which(data$species == x),]
temp$duration <- temp$duration*temp$count
temp$duration <- scale(log(temp$duration))
temp$count <- scale(log(temp$count))
return(temp)
}))
#run combined model on cumulative durations
#if effects are present, then sole (2010) explanation is not a problem
